<script src="https://cdn.bootcss.com/qs/6.5.1/qs.min.js"></script>
  <script>
  Vue.component("bander",{
      props:{},
      data(){
        return {
        brand:"Career",
        innerweb:"好友網頁",
        otherdata:"維管其他資料",
        modeltype:"訪客留言資料維管",
        innerweburl:"",
        datamanageurl:"",
        statusreport:'<%- statusreport %>',
        personID:'<%- personID %>'
        }
      },
      mounted:function(){
        this.innerweburl="/career/branch/goinnerweb/"+this.personID;
        this.datamanageurl="/career/branch/gomaintainer/"+this.personID
      },
      methods:{
  
      },
      template:"#banderUI"
    });
    Vue.component("inputer",{
      props:{},
      data(){
        return {
        }   
      },
      methods:{
  
      },
      template:"#inputerUI"
    });
    Vue.component("outputer",{
      props:{},
      data(){
        return{
          pageSize: 10,        // 每頁10筆
          maxPageButtons: 8,    // 頁碼最多8個
          currentPage:1,
          statusreport:'<%- JSON.stringify(statusreport) %>',
          personID:'<%- personID %>',
          inputpageurl:"",
          inputbatchurl:"",
          messagelist:JSON.parse(decodeURIComponent('<%=messagelist%>')),
        items:{
            item0:"留言者IP",
            item1:"留言者",
            item2:"留言日期時間",
            item3:"留言標題",
            item4:"留言內容",
            item5:"同人前則留言代碼",
            item6:"本則留言代碼",
            item7:"回應者",
            item8:"回應內容",
            item9:"後續追踪",
            item99:"特別註記"     
            }
        }      
      },
    computed: {
        totalPages() {
          const n = this.messagelist.length;
          return Math.max(1, Math.ceil(n / this.pageSize));
        },

        pagedMessages() {
          const start = (this.currentPage - 1) * this.pageSize;
          return this.messagelist.slice(start, start + this.pageSize);
        },

        pageRange() {
      const total = this.totalPages;
      const size = this.maxPageButtons;

      // total <= size：全部顯示
      if (total <= size) {
        return { start: 1, end: total };
      }

      // 以 currentPage 為中心，計算左右要分配多少格
      // size=8 => left=3 right=4（讓 currentPage 偏左一點，右邊多一格）
      const left = Math.floor((size - 1) / 2);   // 3
      const right = (size - 1) - left;          // 4

      let start = this.currentPage - left;
      let end = this.currentPage + right;

      // 若超出左界：往右推回來
      if (start < 1) {
        start = 1;
        end = start + size - 1;
      }

      // 若超出右界：往左推回來
      if (end > total) {
        end = total;
        start = end - size + 1;
      }

      return { start, end };
      },


        pageButtons() {
          const { start, end } = this.pageRange;
          const pages = [];
          for (let p = start; p <= end; p++) pages.push(p);
          return pages;
        },

        // 分頁區最小號碼不是1 => 顯示「到最前頁」
        showFirst() {
          return this.pageRange.start > 1;
        },

        // 總頁數超過目前分頁區最大號碼 => 顯示「到最末頁」
        showLast() {
          return this.pageRange.end < this.totalPages;
        }
      },

      watch: {
        // messagelist 更新後，避免頁碼超界
        messagelist() {
          if (this.currentPage > this.totalPages) this.currentPage = this.totalPages;
          if (this.currentPage < 1) this.currentPage = 1;
        }
      },
      mounted:function(){
        this.inputpageurl="/career/message/inputpage/"+this.personID;
        this.inputbatchurl="/career/message/inputbatch/"+this.personID
      },
      methods:{
        editone:function(id){
          let querytext="?statusreport=由message資料清單頁的編輯按鈕進入本頁&status=0";
          let url2='/career/message/editpage/'+this.personID+"/"+id+querytext;
          window.location=url2;
        }, 
        deleteone:function(id){
          let querytext="?statusreport=由message資料清單頁的刪除按鈕進入本頁&status=0";
          let url3='/career/message/delete/'+this.personID+"/"+id+querytext;
          window.location=url3
           },
        goPage(p) {
          if (p < 1 || p > this.totalPages) return;
          this.currentPage = p;
        }
      },
    template:"#outputerUI"
  });
    new Vue({
        el:'#show_div',
        data:{
          testdata:'有執行到此。。。。'
        },
