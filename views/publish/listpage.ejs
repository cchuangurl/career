    <template id="outputerUI">
        <nav aria-label="...">
          <table>
            <tr>
            <td>
              <form  :action="inputpageurl" method="get" >
                <input type="hidden" name="statusreport" value="由單筆手動新增按鈕進來">
                <input type="hidden" name="status" value="0">
                <input type="submit" value="單筆手動新增">
                </form>
                </td>
                <td>
                  <form  :action="inputbatchurl" method="get" >
                 資料主檔名：<input type="text" name="datafile" required>
                 <input type="hidden" name="statusreport" value="由批次新增進入本頁">
                 <input type="hidden" name="status" value="0">
                 <input type="submit" value="批次新增">
             </form>
             </td>

            <td>
            （/public目錄下.csv檔）
            </td>
            <td>
            <span class="navbar-text">
                <font size="1">{{statusreport}}</font>
              </span>
            </td>
            </tr>
            </table>
          <!-- 分頁區 -->
  <div class="pager" v-if="totalPages > 1">
    <!-- 到最前頁（當分頁區最小號碼不是1時顯示） -->
    <button
      v-if="showFirst"
      type="button"
      class="pager-btn"
      @click="goPage(1)"
      title="到最前頁"
    >
      到最前頁
    </button>

    <!-- 前一頁（當前頁碼為1時不顯示） -->
    <button
      v-if="currentPage > 1"
      type="button"
      class="pager-btn"
      @click="goPage(currentPage - 1)"
    >
      前一頁
    </button>

    <!-- 頁碼（最多8個；當前頁 disable） -->
    <button
      v-for="p in pageButtons"
      :key="'p' + p"
      type="button"
      class="pager-btn"
      :disabled="p === currentPage"
      :class="{ active: p === currentPage }"
      @click="goPage(p)"
    >
      {{ p }}
    </button>

    <!-- 下一頁（當前頁碼為最末頁時不顯示） -->
    <button
      v-if="currentPage < totalPages"
      type="button"
      class="pager-btn"
      @click="goPage(currentPage + 1)"
    >
      下一頁
    </button>

    <!-- 到最末頁（當總頁數超過目前分頁區最大號碼時顯示） -->
    <button
      v-if="showLast"
      type="button"
      class="pager-btn"
      @click="goPage(totalPages)"
      title="到最末頁"
    >
      到最末頁
    </button>

    <!-- 總頁數/總筆數訊息 -->
    <span class="pager-info">
      共 {{ publishlist.length }} 筆｜共 {{ totalPages }} 頁｜目前第 {{ currentPage }} 頁
    </span>
  </div>
  </div>
        <table border="1" class="table table-striped">
            <thead>
            <tr>
              <th>{{items.item2}}</th>
                <th>{{items.item3}}</th>
                <th>{{items.item4}}</th>
                <th>{{items.item8}}：{{items.item9}}</th>
               <!--<th>特別註記</th> -->
            </tr>
            </thead>
            <tbody id="publishlist">
              <tr v-for="(publish, idx) in pagedPublishs" :key="publish.id || (publish.title + '_' + idx)">
                <td>{{formatDate(publish.a15year)}}</td>
                <td>{{publish.a20title}}</td>
                <td>{{publish.a25book}}</td>
                <td>{{publish.a45volumn}}：{{publish.a50issue}}</td>
                <!-- statusreport="由已擷取資料組清單頁進入本頁"> -->

                  <td>
                    <input type="submit" value="檢視或編輯" @click="editone(publish._id)">
                  </td>
                  <td>
                    <input type="submit" value="刪除" @click="deleteone(publish._id)">
                  </td>
                </tr>
            </tbody>
        </table>
          <!-- 分頁區 -->
  <div class="pager" v-if="totalPages > 1">
    <!-- 到最前頁（當分頁區最小號碼不是1時顯示） -->
