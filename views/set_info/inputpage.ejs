<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">
<script src="https://cdn.bootcdn.net/ajax/libs/jquery/3.4.1/jquery.js"></script>
<style type="text/css">
body {
  background-color: #d6d6d3;
  height: 100vh;
  width: 100vw;
  display: flex;
     flex-direction:column;
	 justify-content: flex-start;
     align-items:center;
  	margin: 0;
}
.navbar{background:#ddedf8;}
.nav-link, .navbar-brand{color: #f4f4f4;cursor:pointer;}
.nav-link{margin-right:1em !important;}
.nav-link:hover{background: #f4f4f4;color:#f97300;}
.navbar-collapse{justify-content:flex-end;}
.navbar-toggler{background:#fff !important;}
</style>

  <title>單筆set_info資料</title>
  </head>
  <body>
    <div id="show_div">
      <bander></bander>
        <inputer></inputer>
    </div>

    <template id="banderUI">
      <nav class="navbar navbar-expand-lg navbar-light">
        <a class="navbar-brand" href="#">{{brand}}</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarText" aria-controls="navbarText" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarText">
          <ul class="navbar-nav mr-auto">
            <li class="nav-item">
              <a class="nav-link" :href="listpageurl">{{listpage}}</a>
              </li>
            <li class="nav-item active">
              <a class="nav-link" href="#">{{input1}}<span class="sr-only">(current)</span></a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#">{{inputbatch}}</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#">{{crawl}}</a>
            </li>
          </ul>
          <span class="navbar-text">
            <font size="1">{{statusreport}}</font>
          </span>
        </div>
      </nav>
    </template>

    <template id="inputerUI" ">
      <div class="card" style="width: 36rem;" >
        <div class="card-body">
          <h5 class="card-title">{{card_title}}</h5>
          <h6 class="card-subtitle mb-2 text-muted">{{card_subtitle}}</h6>
          <form :action="addurl" method="post">
            <div class="form-group" :key="inputerUIkey">

              <label for="formGroupExampleInput2">{{items.item0}}</label>
              <input type="text" :name="names.name0" class="form-control" id="formGroupExampleInput0" :placeholder="holders.holder0">

              <label for="formGroupExampleInput2">{{items.item1}}</label>
              <input type="text" :name="names.name1" class="form-control" id="formGroupExampleInput1" :placeholder="holders.holder1">

              <label for="formGroupExampleInput2">{{items.item2}}</label>
              <input type="text" :name="names.name2" class="form-control" id="formGroupExampleInput2" :placeholder="holders.holder2">

              <label for="formGroupExampleInput2">{{items.item3}}</label>
              <input type="text" :name="names.name3" class="form-control" id="formGroupExampleInput3" :placeholder="holders.holder3">

              <label for="formGroupExampleInput2">{{items.item4}}</label>
              <input type="text" :name="names.name4" class="form-control" id="formGroupExampleInput4" :placeholder="holders.holder4">

              <label for="formGroupExampleInput2">{{items.item5}}</label>
              <input type="text" :name="names.name5" class="form-control" id="formGroupExampleInput5" :placeholder="holders.holder5">

              <label for="formGroupExampleInput2">{{items.item6}}</label>
              <input type="text" :name="names.name6" class="form-control" id="formGroupExampleInput6" :placeholder="holders.holder6">
              
              <label for="formGroupExampleInput2">{{items.item7}}</label>
              <input type="text" :name="names.name7" class="form-control" id="formGroupExampleInput7" :placeholder="holders.holder7">
              <!--
              <label for="formGroupExampleInput2">{{items.item8}}</label>
              -->
              <input type="hidden" :name="names.name8" class="form-control" id="formGroupExampleInput8" value="00000000">
              
              <label for="formGroupExampleInput2">{{items.item9}}</label>
              <input type="text" :name="names.name9" class="form-control" id="formGroupExampleInput9" :placeholder="holders.holder9">
              <!--
              <label for="formGroupExampleInput2">{{items.item10}}</label>
              -->
              <input type="hidden" :name="names.name10" class="form-control" id="formGroupExampleInput10" value="000000">
              
              <label for="formGroupExampleInput">{{items.item99}}</label>
              <input type="text" name="a99footnote" class="form-control" id="formGroupExampleInput99" :placeholder="holders.holder99">

              <input type="hidden" name="statusreport" class="form-control" id="msg1" value="由單筆set_info輸入後進入本頁">
              <input type="hidden" name="status" class="form-control" id="msg2" value="0">
              <input type="submit" id="button1" value="確定送出" class="btn btn-info">
            </div>
          </form>
          <input type="submit" id="button2" value="重新輸入" class="btn btn-info" @click="rerender()">
            <!-- <a href="#" class="card-link">Card link</a>
            <a href="#" class="card-link">Another link</a> -->
        </div>
      </div>
    </template>

<!-- Vue CDN-->
<script src="https://unpkg.com/vue@2.6.14/dist/vue.js"></script>
<script>
Vue.component("bander",{

    data(){
      return {
        brand:"career",
        listpage:"回前頁",
        input1:"手動新增1筆",
        inputbatch:"批次輸入",
        crawl:"從網路抓取",
        statusreport:'<%- statusreport %>',
        personID:'<%- personID %>',
        listpageurl:""        
      }
    },
    mounted:function(){
      this.listpageurl="/career/set_info/"+this.personID
    },

    template:"#banderUI"
  });
  Vue.component("inputer",{

    data(){
      return {
        card_title:"新增1個用詞對照",
        card_subtitle:"請輸入以下各項資料:",
        items:{
          item0:"資料所在網址",
          item1:"資料組編號",
          item2:"本批次擷取筆數",
          item3:"跳過之筆數(即過去已擷取之筆數)",
          item4:"查詢條件(含擷取筆數、資料日期、所需欄位、符合之標準等)",
          item5:"資料排序方式(欄位名稱及排序方向)",
          item6:"給予之此批次資料簡稱",
          item7:"資料描述",
          item8:"擷取日期",
          item9:"檔名主要字母",
          item10:"同檔名時之序號",
          item99:"特別註記"
          },
        names:{
          name0:"a05archive_url",
          name1:"a10unitID",
          name2:"a15data_volume",
          name3:"a20skip",
          name4:"a25filter",
          name5:"a30order",
          name6:"a35dataset_name",
          name7:"a40describe",
          name8:"a45date_of_get",
          name9:"a50filename_part",
          name10:"a55preventer"
            },
        holders:{
          holder0:"字串,合法網址",
          holder1:"字串,正整數",
          holder2:"數字,正整數",
          holder3:"數字,大於等於0之整數",
          holder4:"字串,(無)",
          holder5:"字串,(無)",
          holder6:"字串,(無)",
          holder7:"字串,(無)",
          holder8:"日期時間,合法日期",
          holder9:"字串,(無)",
          holder10:"數字,個位數",
          holder99:"字串"
            },
      inputerUIkey:0,
      personID: '<%- personID %>',
      addurl:""
      }
    },
    mounted:function(){
        this.addurl="/career/set_info/add/"+this.personID;
        
    },
    methods:{
      rerender:function() {
      this.inputerUIkey += 1;
      console.log("inputerUIkey:"+this.inputerUIkey)
    }
    },

    template:"#inputerUI"
  });

    new Vue({
        el:'#show_div',
        data:{
          testdata:'有執行到此。。。。'
        },
        /* computed:{

        },
        watch:{

        },
        filters:{

        },
        mixins:[

        ],
        template:" ",
        components:{

        },*/
        beforeCreate:function(){
          console.log("before create...")
        },created:function(){
          console.log("created...")
        },
        beforeMount:function(){
          console.log("before mount...")
        },
        mounted:function(){
          console.log("mounted...")
        },
        beforeUpdate:function(){
          console.log("before update...")
        },
        updated:function(){
          console.log("updated...")
        },
        beforeDestroy:function(){

        }
    })
</script>


  </body>
</html>