          personID:'<%- personID %>',
          //previousurl:"",
          otherdata:"維管其他資料",
          datamanageurl:"",
          KMurl:"",
          innerweburl:""
          }
      },
          mounted:function(){
            this.innerweburl="/career/branch/goinnerweb/"+this.personID,
            this.datamanageurl="/career/branch/gomaintainer/"+this.personID
            this.KMurl="/career/branch/goKM/"+this.personID
          },
      methods:{

      },
      template:"#banderUI"
    });
    /*
    Vue.component("inputer",{
      props:{},
      data(){
        return {


        }
      },

      methods:{

      },
      template:"#inputerUI"
    });
    */
    Vue.component("outputer",{
      props:{},
      data(){
        return{
          pageSize: 10,        // 每頁10筆
          maxPageButtons: 8,    // 頁碼最多8個
          currentPage:1,
          statusreport:'<%- statusreport %>',
          personID:'<%- personID %>',
          inputpageurl:"",
          inputbatchurl:"",
          set_infolist:JSON.parse(decodeURIComponent('<%=set_infolist%>')),
        items:{
            item0:"資料所在網址",
            item1:"資料組編號",
            item2:"本批次擷取筆數",
            item3:"跳過之筆數(即過去已擷取之筆數)",
            item4:"查詢條件(含起始日期、結束日期、所需欄位、符合之標準等)",
            item5:"資料排序方式(欄位名稱及排序方向)",
            item6:"給予之此批次資料簡稱",
            item7:"資料描述",
            item8:"擷取日期",
            item9:"檔名主要字母",
            item10:"同檔名時之序號",
            item99:"特別註記"
            }
        }
      },
    computed: {
        totalPages() {
          const n = this.set_infolist.length;
          return Math.max(1, Math.ceil(n / this.pageSize));
        },

        pagedSet_infos() {
          const start = (this.currentPage - 1) * this.pageSize;
          return this.set_infolist.slice(start, start + this.pageSize);
        },

        pageRange() {
      const total = this.totalPages;
      const size = this.maxPageButtons;

      // total <= size：全部顯示
      if (total <= size) {
        return { start: 1, end: total };
      }

      // 以 currentPage 為中心，計算左右要分配多少格
      // size=8 => left=3 right=4（讓 currentPage 偏左一點，右邊多一格）
      const left = Math.floor((size - 1) / 2);   // 3
      const right = (size - 1) - left;          // 4

      let start = this.currentPage - left;
      let end = this.currentPage + right;

      // 若超出左界：往右推回來
      if (start < 1) {
        start = 1;
        end = start + size - 1;
      }

      // 若超出右界：往左推回來
      if (end > total) {
        end = total;
        start = end - size + 1;
      }

      return { start, end };
      },


        pageButtons() {
          const { start, end } = this.pageRange;
          const pages = [];
          for (let p = start; p <= end; p++) pages.push(p);
          return pages;
        },

        // 分頁區最小號碼不是1 => 顯示「到最前頁」
        showFirst() {
          return this.pageRange.start > 1;
        },

        // 總頁數超過目前分頁區最大號碼 => 顯示「到最末頁」
        showLast() {
          return this.pageRange.end < this.totalPages;
        }
      },

      watch: {
        // set_infolist 更新後，避免頁碼超界
        set_infolist() {
          if (this.currentPage > this.totalPages) this.currentPage = this.totalPages;
          if (this.currentPage < 1) this.currentPage = 1;
        }
      },      
      mounted:function(){
        this.inputpageurl="/career/set_info/inputpage/"+this.personID;
        this.inputbatchurl="/career/set_info/inputbatch/"+this.personID        
      },
      methods:{
        editone:function(id){
          let querytext="?statusreport=由set_info資料清單頁的編輯按鈕進入本頁";
          let url2='/career/set_info/editpage/'+this.personID+"/"+id+querytext;
          window.location=url2;
        },
        deleteone:function(id){
          let querytext="?statusreport=由set_info資料清單頁的刪除按鈕進入本頁";
          let url3='/career/set_info/delete/'+this.personID+"/"+id+querytext;
          window.location=url3
           },
           getdata:function(id){
          let querytext="?statusreport=由set_info資料清單頁的getdata按鈕進入本頁";
          let url3='/career/set_info/getdata/'+this.personID+"/"+id+querytext;
          window.location=url3
           },
        goPage(p) {
          if (p < 1 || p > this.totalPages) return;
          this.currentPage = p;
        }
      },
    template:"#outputerUI"
  });
    new Vue({
        el:'#show_div',
        data:{
          testdata:'有執行到此。。。。'
        },
