          $("#formGroupExampleInput2").focus()
        }
      },
     
      template:"#content3UI"
    };    
    const routes=[
      {path:"/career/outerweb/paper",component:content1},
      {path:"/media",component:content1},
      {path:"/course",component:content2},
      {path:"/manage",component:content3}
