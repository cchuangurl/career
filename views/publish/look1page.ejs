            <label for="formGroupExampleInput2">{{items.item4}}</label>
            <input type="text" :name="names.name4" class="form-control" id="formGroupExampleInput4" :value="publish.a25book">

            <label for="formGroupExampleInput2">{{items.item5}}</label>
            <input type="text" :name="names.name5" class="form-control" id="formGroupExampleInput5" :value="publish.a30collection">

            <label for="formGroupExampleInput2">{{items.item6}}</label>
            <input type="text" :name="names.name6" class="form-control" id="formGroupExampleInput6" :value="publish.a35editor">

            <label for="formGroupExampleInput2">{{items.item7}}</label>
            <input type="text" :name="names.name7" class="form-control" id="formGroupExampleInput7" :value="publish.a40part">

            <label for="formGroupExampleInput2">{{items.item8}}</label>
            <input type="text" :name="names.name8" class="form-control" id="formGroupExampleInput8" :value="publish.a45volumn">

            <label for="formGroupExampleInput2">{{items.item9}}</label>
            <input type="text" :name="names.name9" class="form-control" id="formGroupExampleInput9" :value="publish.a50issue">

            <label for="formGroupExampleInput2">{{items.item10}}</label>
            <input type="text" :name="names.name10" class="form-control" id="formGroupExampleInput10" :value="publish.a55startpage">

            <label for="formGroupExampleInput2">{{items.item11}}</label>
            <input type="text" :name="names.name11" class="form-control" id="formGroupExampleInput11" :value="publish.a60endpage">

            <label for="formGroupExampleInput2">{{items.item12}}</label>
            <input type="text" :name="names.name12" class="form-control" id="formGroupExampleInput12" :value="publish.a65publisher">

            <label for="formGroupExampleInput2">{{items.item13}}</label>
            <input type="text" :name="names.name13" class="form-control" id="formGroupExampleInput13" :value="publish.a70website">

            <label for="formGroupExampleInput2">{{items.item14}}</label>
            <input type="text" :name="names.name14" class="form-control" id="formGroupExampleInput14" :value="publish.a75city">
              <input type="submit" id="button1" value="回前頁" class="btn btn-info">
            </div>
          </form>
        </div>
      </div>
    </template>


<!-- Vue CDN-->
