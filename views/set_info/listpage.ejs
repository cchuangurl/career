            </tr>
            </thead>
            <tbody id="set_infolist">
              <tr v-for="(set_info, idx) in pagedSet_infos" :key="set_info._id || (set_info.a10unitID+ '_' + idx)">
                <td>{{set_info.a35dataset_name}}</td>
                <td>{{set_info.a45date_of_get}}</td>
                <td>{{set_info.a15data_volume}}</td>
                <td>{{set_info.a20skip}}</td>
                <!-- statusreport="由已擷取資料組清單頁進入本頁"> -->

                  <td>
                    <input type="submit" value="檢視或編輯" @click="editone(set_info._id)">
                  </td>
                  <td>
                    <input type="submit" value="取回opendata" @click="getdata(set_info._id)">
                  </td>
                  <td>
                    <input type="submit" value="刪除" @click="deleteone(set_info._id)">
                  </td>
                </tr>
            </tbody>
        </table>
          <!-- 分頁區 -->
