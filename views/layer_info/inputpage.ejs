          item7:"上一層的key",
          item8:"本項資料的單位",
          item9:"欄位名稱",
          item99:"特別註記"
          },
        names:{
          name0:"a05set_infoID",
          name1:"a10dataset_name",
          name2:"a15key_name",
          name3:"a20data_layer",
          name4:"a25no_subkey",
          name5:"a30no_container",
          name6:"a35upper_layerID",
          name7:"a40upper_key",
          name8:"a45unit",
          name9:"a50field_name"
            },
        holders:{
          holder0:"物件識別碼,256hash",
          holder1:"字串,(無)",
          holder2:"字串,(無)",
          holder3:"數字,正整數",
          holder4:"數字,正整數",
          holder5:"數字,正整數",
          holder6:"物件識別碼,256hash",
          holder7:"字串,(無)",
          holder8:"字串,(無)",
          holder9:"字串,(無)",
          holder99:"字串"
            },
      inputerUIkey:0,
      personID: '<%- personID %>',
      addurl:""
      }
    },
    mounted:function(){
        this.addurl="/career/layer_info/add/"+this.personID;
    },
    methods:{
        rerender:function() {
      this.inputerUIkey += 1;
      console.log("inputerUIkey:"+this.inputerUIkey)
    }
    },

    template:"#inputerUI"
  });

    new Vue({
        el:'#show_div',
        data:{
          testdata:'有執行到此。。。。'
        },
