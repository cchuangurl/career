<script src="https://cdn.bootcss.com/qs/6.5.1/qs.min.js"></script>
  <script>
  Vue.component("bander",{
      props:{},
      data(){
        return {
        brand:"Career",
        innerweb:"好友網頁",
        otherdata:"維管其他資料",
        modeltype:"出版資料維管",
        innerweburl:"",
        datamanageurl:"",
        statusreport:'<%- statusreport %>',
        personID:'<%- personID %>'
        }
      },
      mounted:function(){
        this.innerweburl="/career/branch/goinnerweb/"+this.personID;
        this.datamanageurl="/career/branch/gomaintainer/"+this.personID
      },
      methods:{

      },
      template:"#banderUI"
    });
    Vue.component("inputer",{
      props:{},
      data(){
        return {
        }
      },
      methods:{

      },
      template:"#inputerUI"
    });
    Vue.component("outputer",{
      props:{},
      data(){
        return{
          pageSize: 10,        // 每頁10筆
          maxPageButtons: 8,    // 頁碼最多8個
          currentPage:1,
          statusreport:'<%- JSON.stringify(statusreport) %>',
          personID:'<%- personID %>',
          inputpageurl:"",
          inputbatchurl:"",
          publishlist:JSON.parse(decodeURIComponent('<%=publishlist%>')),
        items:{
          item0:"對應的knowledge",
            item1:"共同作者",
            item2:"出版或完稿年",
            item3:"標題",
            item4:"刊物或研討會名",
            item5:"彙編或總集",
            item6:"編輯者",
            item7:"篇",
            item8:"卷",
            item9:"期",
            item10:"起頁",
            item11:"末頁",
            item12:"出版商",
            item13:"網址",
            item14:"城市",
            item99:"特別註記"
            }
        }
      },
    computed: {
        totalPages() {
          const n = this.publishlist.length;
          return Math.max(1, Math.ceil(n / this.pageSize));
        },

        pagedPublishs() {
          const start = (this.currentPage - 1) * this.pageSize;
          return this.publishlist.slice(start, start + this.pageSize);
        },

        pageRange() {
      const total = this.totalPages;
      const size = this.maxPageButtons;

      // total <= size：全部顯示
      if (total <= size) {
        return { start: 1, end: total };
      }

      // 以 currentPage 為中心，計算左右要分配多少格
      // size=8 => left=3 right=4（讓 currentPage 偏左一點，右邊多一格）
      const left = Math.floor((size - 1) / 2);   // 3
      const right = (size - 1) - left;          // 4

      let start = this.currentPage - left;
      let end = this.currentPage + right;

      // 若超出左界：往右推回來
      if (start < 1) {
        start = 1;
        end = start + size - 1;
      }

      // 若超出右界：往左推回來
      if (end > total) {
        end = total;
        start = end - size + 1;
      }

      return { start, end };
      },


        pageButtons() {
          const { start, end } = this.pageRange;
          const pages = [];
          for (let p = start; p <= end; p++) pages.push(p);
          return pages;
        },

        // 分頁區最小號碼不是1 => 顯示「到最前頁」
        showFirst() {
          return this.pageRange.start > 1;
        },

        // 總頁數超過目前分頁區最大號碼 => 顯示「到最末頁」
        showLast() {
          return this.pageRange.end < this.totalPages;
        }
      },

      watch: {
        // publishlist 更新後，避免頁碼超界
        publishlist() {
          if (this.currentPage > this.totalPages) this.currentPage = this.totalPages;
          if (this.currentPage < 1) this.currentPage = 1;
        }
      },            
      mounted:function(){
        this.inputpageurl="/career/publish/inputpage/"+this.personID;
        this.inputbatchurl="/career/publish/inputbatch/"+this.personID
      },
      methods:{
        editone:function(id){
          let querytext="?statusreport=由publish資料清單頁的編輯按鈕進入本頁";
          let url2='/career/publish/editpage/'+this.personID+"/"+id+querytext;
          window.location=url2;
        },
        deleteone:function(id){
          let querytext="?statusreport=由publish資料清單頁的刪除按鈕進入本頁";
          let url3='/career/publish/delete/'+this.personID+"/"+id+querytext;
          window.location=url3
           },
        goPage(p) {
          if (p < 1 || p > this.totalPages) return;
          this.currentPage = p;
        },
        formatDate(date) {
              // 若後端給 '2026-01-07' 或 ISO 字串都可處理
              if (!date) return '';
              // 不強制格式：你可以改成自己想要的顯示
              return String(date).slice(0, 4);
            }
      },
    template:"#outputerUI"
  });
    new Vue({
        el:'#show_div',
        data:{
          testdata:'有執行到此。。。。'
        },
