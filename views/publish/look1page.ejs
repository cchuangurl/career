          <h6 class="card-subtitle mb-2 text-muted">{{card_subtitle}}</h6>
          <form :action="lastpageurl" method="get">
            <div class="form-group" :key="inputerUIkey">
            <label for="formGroupExampleInput2">{{items.item1}}</label>
            <input type="text" :name="names.name1" class="form-control" id="formGroupExampleInput1" :value="publish.a10coauthor">

            <label for="formGroupExampleInput2">{{items.item2}}</label>
            <input type="text" :name="names.name2" class="form-control" id="formGroupExampleInput2" :value="publish.a15year">

