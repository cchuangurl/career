          <!-- 分頁區 -->
  <div class="pager" v-if="totalPages > 1">
    <!-- 到最前頁（當分頁區最小號碼不是1時顯示） -->
    <button
      v-if="showFirst"
      type="button"
      class="pager-btn"
      @click="goPage(1)"
      title="到最前頁"
    >
      到最前頁
    </button>

    <!-- 前一頁（當前頁碼為1時不顯示） -->
    <button
      v-if="currentPage > 1"
      type="button"
      class="pager-btn"
      @click="goPage(currentPage - 1)"
    >
      前一頁
    </button>

    <!-- 頁碼（最多8個；當前頁 disable） -->
    <button
      v-for="p in pageButtons"
      :key="'p' + p"
      type="button"
      class="pager-btn"
      :disabled="p === currentPage"
      :class="{ active: p === currentPage }"
      @click="goPage(p)"
    >
      {{ p }}
    </button>

    <!-- 下一頁（當前頁碼為最末頁時不顯示） -->
    <button
      v-if="currentPage < totalPages"
      type="button"
      class="pager-btn"
      @click="goPage(currentPage + 1)"
    >
      下一頁
    </button>

    <!-- 到最末頁（當總頁數超過目前分頁區最大號碼時顯示） -->
    <button
      v-if="showLast"
      type="button"
      class="pager-btn"
      @click="goPage(totalPages)"
      title="到最末頁"
    >
      到最末頁
    </button>

    <!-- 總頁數/總筆數訊息 -->
    <span class="pager-info">
      共 {{ set_infolist.length }} 筆｜共 {{ totalPages }} 頁｜目前第 {{ currentPage }} 頁
    </span>
  </div>
  </div>
        <table border="1" class="table table-striped">
            <thead>
            <tr>
                <th>{{items.item6}}</th>
                <th>{{items.item8}}</th>
                <th>{{items.item2}}</th>
